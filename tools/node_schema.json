{
 "TextGenerate": {
  "input": {
   "required": {
    "clip": [
     "CLIP",
     {}
    ],
    "prompt": [
     "STRING",
     {
      "default": "",
      "multiline": true,
      "dynamicPrompts": true
     }
    ],
    "max_length": [
     "INT",
     {
      "default": 512,
      "min": 1,
      "max": 32768
     }
    ],
    "sampling_mode": [
     "COMFY_DYNAMICCOMBO_V3",
     {
      "display_name": "Sampling Mode",
      "options": [
       {
        "key": "on",
        "inputs": {
         "required": {
          "temperature": [
           "FLOAT",
           {
            "default": 0.7,
            "min": 0.01,
            "max": 2.0,
            "step": 1e-06
           }
          ],
          "top_k": [
           "INT",
           {
            "default": 64,
            "min": 0,
            "max": 1000
           }
          ],
          "top_p": [
           "FLOAT",
           {
            "default": 0.95,
            "min": 0.0,
            "max": 1.0,
            "step": 0.01
           }
          ],
          "min_p": [
           "FLOAT",
           {
            "default": 0.05,
            "min": 0.0,
            "max": 1.0,
            "step": 0.01
           }
          ],
          "repetition_penalty": [
           "FLOAT",
           {
            "default": 1.05,
            "min": 0.0,
            "max": 5.0,
            "step": 0.01
           }
          ],
          "seed": [
           "INT",
           {
            "default": 0,
            "min": 0,
            "max": 18446744073709551615
           }
          ]
         },
         "optional": {
          "presence_penalty": [
           "FLOAT",
           {
            "default": 0.0,
            "min": 0.0,
            "max": 5.0,
            "step": 0.01
           }
          ]
         }
        }
       },
       {
        "key": "off",
        "inputs": {
         "required": {}
        }
       }
      ]
     }
    ]
   },
   "optional": {
    "image": [
     "IMAGE",
     {}
    ],
    "video": [
     "IMAGE",
     {
      "tooltip": "Video frames as image batch. Assumed to be 24 FPS; subsampled to 1 FPS internally."
     }
    ],
    "audio": [
     "AUDIO",
     {}
    ],
    "thinking": [
     "BOOLEAN",
     {
      "tooltip": "Operate in thinking mode if the model supports it.",
      "default": false
     }
    ],
    "use_default_template": [
     "BOOLEAN",
     {
      "tooltip": "Use the built in system prompt/template if the model has one.",
      "advanced": true,
      "default": true
     }
    ],
    "mtp": [
     "COMBO",
     {
      "tooltip": "Speculative decoding with the checkpoint's multi-token-prediction head. No effect without MTP weights. auto adapts the draft depth; 2-5 pins it. Sampled output stays correctly distributed but differs from non-MTP output for the same seed.",
      "default": "auto",
      "multiselect": false,
      "options": [
       "auto",
       "off",
       "2",
       "3",
       "4",
       "5"
      ]
     }
    ],
    "system_prompt": [
     "STRING",
     {
      "tooltip": "Replaces the system prompt in the model's chat template. Ignored when the default template is not used.",
      "forceInput": true,
      "multiline": false
     }
    ]
   }
  },
  "input_order": {
   "required": [
    "clip",
    "prompt",
    "max_length",
    "sampling_mode"
   ],
   "optional": [
    "image",
    "video",
    "audio",
    "thinking",
    "use_default_template",
    "mtp",
    "system_prompt"
   ]
  },
  "output": [
   "STRING",
   "STRING"
  ],
  "output_name": [
   "generated_text",
   "thinking"
  ],
  "python_module": "comfy_extras.nodes_textgen"
 },
